---
import { img, srcset } from '@/lib/cloudinary';
const { p, eager = false } = Astro.props as { p: { slug: string; title: string; coverPublicId: string | null; categoryName?: string | null }; eager?: boolean };
---
<a href={`/work/${p.slug}`} class="group block">
  <div class="aspect-[4/3] overflow-hidden bg-coal">
    {p.coverPublicId && (
      <img src={img(p.coverPublicId, 768, { h: 576 })} srcset={srcset(p.coverPublicId)} sizes="(min-width:1024px) 33vw,(min-width:768px) 50vw,100vw"
        alt={p.title} width="768" height="576" loading={eager ? 'eager' : 'lazy'} decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
    )}
  </div>
  {p.categoryName && <p class="mt-4 text-xs font-extrabold uppercase tracking-widest text-amber">{p.categoryName}</p>}
  <h3 class="mt-1 text-xl font-extrabold group-hover:text-amber">{p.title}</h3>
</a>
