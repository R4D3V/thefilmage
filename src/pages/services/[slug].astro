---
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { and, asc, desc, eq, ne } from 'drizzle-orm';
import { getDb, schema } from '@/db/client';
import { img, srcset } from '@/lib/cloudinary';

const db = getDb();
const slug = Astro.params.slug!;
const [service] = await db
  .select()
  .from(schema.services)
  .where(and(eq(schema.services.slug, slug), eq(schema.services.published, true)))
  .limit(1);
if (!service) return new Response(null, { status: 404 });

const others = await db
  .select()
  .from(schema.services)
  .where(and(eq(schema.services.published, true), ne(schema.services.id, service.id)))
  .orderBy(asc(schema.services.position))
  .limit(6);

const work = await db
  .select({ p: schema.projects, categoryName: schema.categories.name })
  .from(schema.projects)
  .leftJoin(schema.categories, eq(schema.projects.categoryId, schema.categories.id))
  .where(eq(schema.projects.published, true))
  .orderBy(desc(schema.projects.createdAt))
  .limit(3);

const kindWords = await db
  .select()
  .from(schema.testimonials)
  .where(eq(schema.testimonials.published, true))
  .orderBy(desc(schema.testimonials.createdAt))
  .limit(2);

// Curated detail content per service. Falls back to a generic list for new services.
const DETAILS: Record<string, string[]> = {
  'video-production': ['Concept, scripting and shot planning', 'Full-day multi-camera coverage with pro audio', 'Licensed music and sound design', 'Drone/aerial shots where permitted', '4K master plus social-media cutdowns', 'Two rounds of revisions before final delivery'],
  videography: ['Pre-shoot consultation and shot list', 'Cinematic coverage — events, film, music videos, docs', 'Gimbal and drone movement where permitted', 'Pro audio capture and licensed music', 'Highlight reel plus full-length edit', 'Delivery in 4K for web, TV and social'],
  photography: ['Pre-shoot planning and location scouting', 'Event, portrait, brand and commercial coverage', 'Professional retouching of every delivered photo', 'Private online gallery for viewing and download', 'Print-ready and web-optimised files', 'Fast turnaround for time-sensitive events'],
  'video-editing': ['Assembly and story edit from your footage', 'Cinematic colour grade', 'Sound cleanup, mix and licensed music', 'Captions and subtitles', 'Versions for TV, YouTube, TikTok and Reels', 'Project files archived for future updates'],
  'post-production': ['Edit, colour grade and sound finishing under one roof', 'VFX cleanup, titles and motion graphics', 'Mastering to broadcast and platform specs', 'Captions, subtitles and translations on request', 'Multiple aspect ratios from one master', 'Secure backup of your project'],
  'graphic-design': ['Posters, flyers and event branding', 'Social-media carousels, stories and templates', 'Video titles, thumbnails and lower-thirds', 'Print-ready files plus web exports', 'Two revision rounds included', 'Source files handed over on request'],
  branding: ['Logo suite — primary, secondary and icon marks', 'Colour palette and typography system', 'One-page brand guidelines', 'Social profile kit and templates', 'Mockups for packaging, signage and merch', 'Launch assets for web and print'],
  'live-streaming': ['Multi-camera switching with pro audio feed', 'Bonded-internet backup for reliable uptime', 'Branded graphics, lower-thirds and slides', 'Streaming to YouTube, Facebook, Zoom and custom pages', 'Clean ISO recordings of every camera', 'Optional 90-second recap reel'],
  'b2b-video-production': ['Discovery call and creative treatment', 'Brand films, testimonials and explainers', 'Filming at your office or on location', 'Staff-friendly direction — no acting experience needed', 'Cuts for website, LinkedIn and presentations', 'Consistent look across a video series'],
  'cinematographers-equipment-hire': ['Experienced cinematographers and crew', 'Cinema cameras, lenses, gimbals and drones', 'Lighting, grip and location audio kits', 'Half-day and full-day hire rates', 'Rushes delivered same-day on request', 'Wet hire (with operator) or dry hire'],
};
const DEFAULT_DETAILS = ['Free consultation and transparent quote', 'Clear schedule agreed before we start', 'Professional crew and cinema-grade kit', 'Review rounds before final delivery', 'Files delivered for web, social and broadcast'];
const includes = DETAILS[service.slug] ?? DEFAULT_DETAILS;

const STEPS = [
  ['Tell us the story', 'Call, WhatsApp or send the contact form — a few lines about your project is enough.'],
  ['Plan and quote', 'Treatment, schedule and a transparent quote. No hidden costs, no surprises.'],
  ['Shoot and create', 'Our crew handles filming, direction and logistics on the day.'],
  ['Review and deliver', 'You review drafts, we polish, then you get final files in every format you need.'],
];

// Extended editorial copy + use-case chips per service.
const OVERVIEW: Record<string, [string, string]> = {
  'video-production': [
    'Great video starts before anyone presses record. We develop your idea into a shootable concept — script, storyboard and shot plan — then bring the crew, cameras, lighting and sound to execute it in a single, well-run production.',
    'After the shoot we handle the full finish: edit, colour grade, sound design and delivery in every format you need, from broadcast masters to vertical cutdowns for TikTok and Reels.',
  ],
  videography: [
    'Our videographers cover the full arc of your story — the quiet preparations, the main event and the energy in between. We shoot discreetly where it matters and direct confidently where it counts, so the day feels natural and the footage feels cinematic.',
    'Every commission includes professional audio capture and a considered edit: a punchy highlight reel for sharing plus a full-length film you will rewatch for years.',
  ],
  photography: [
    'Still images carry your brand long after an event ends. We shoot with an editor\u2019s eye — decisive moments, genuine expressions and clean compositions — then retouch every delivered frame for consistent, print-ready quality.',
    'You receive a private online gallery for viewing, sharing and download, with files prepared for everything from billboards to profile pictures.',
  ],
  'video-editing': [
    'Already sitting on footage? Send it over. We shape raw rushes into a tight story — selecting the strongest moments, building rhythm and pacing, then finishing with a cinematic grade and a clean, full mix.',
    'We work with footage from any camera, including phones, and deliver platform-ready versions so one edit serves TV, YouTube and every social feed.',
  ],
  'post-production': [
    'Post is where good footage becomes unforgettable. Our finishing pipeline covers picture edit, colour, VFX cleanup, titles, motion graphics and sound — all under one roof, so nothing gets lost between vendors.',
    'We master to exact broadcast and platform specifications and archive your project, so updates, re-edits and new versions are painless months later.',
  ],
  'graphic-design': [
    'Strong graphics make people stop scrolling. We design event branding, posters and social kits with the same cinematic sensibility as our films — bold type, confident colour and layouts that work from billboards to phone screens.',
    'Every package includes print-ready files and web exports, with source files available so your team can adapt designs in future.',
  ],
  branding: [
    'A brand is a promise kept consistently. We build identity systems — logo suite, colours, typography and guidelines — that keep that promise across every touchpoint, from packaging and signage to social profiles.',
    'You launch with more than a logo: mockups, templates and a one-page guideline your whole team can actually follow.',
  ],
  'live-streaming': [
    'Live has no second takes, so reliability is everything. We run multi-camera switched productions with a dedicated audio feed and bonded-internet backup, monitored end to end by an engineer — not a laptop on venue Wi-Fi.',
    'Your audience watches on YouTube, Facebook, Zoom or a private page, and you keep clean recordings of everything plus an optional recap reel for after the event.',
  ],
  'b2b-video-production': [
    'Decision-makers trust people, not brochures. We make corporate video that feels human — brand stories, client testimonials, explainers and recruitment films — shot efficiently at your premises with minimal disruption to your day.',
    'Direction is staff-friendly: no acting experience required. We deliver a consistent series look plus cutdown versions for your website, LinkedIn and presentations.',
  ],
  'cinematographers-equipment-hire': [
    'Need a safe pair of hands or just the kit? Our cinematographers have shot events, commercials and documentaries across Uganda — they arrive prepped, insured-minded and ready to blend into your production.',
    'Hire cameras, lenses, gimbals, drones, lighting and location audio by the half or full day, with an operator (wet hire) or without (dry hire), and get your rushes the same day on request.',
  ],
};
const BEST_FOR: Record<string, string[]> = {
  'video-production': ['Adverts & TVCs', 'Music videos', 'Documentaries', 'Social campaigns', 'Podcasts'],
  videography: ['Weddings & events', 'Music videos', 'Short films', 'Documentary', 'Social content'],
  photography: ['Events', 'Portraits', 'Brand shoots', 'Products', 'Corporate headshots'],
  'video-editing': ['Event edits', 'YouTube channels', 'Reels & TikTok', 'Corporate edits', 'Family archives'],
  'post-production': ['TV masters', 'Colour grading', 'Sound finishing', 'Motion graphics', 'Multi-format delivery'],
  'graphic-design': ['Posters & flyers', 'Social kits', 'Thumbnails', 'Event branding', 'Titles & graphics'],
  branding: ['New businesses', 'Rebrands', 'Product launches', 'NGOs & campaigns', 'Personal brands'],
  'live-streaming': ['Conferences', 'Church services', 'Weddings', 'Concerts', 'Corporate town halls'],
  'b2b-video-production': ['Brand films', 'Testimonials', 'Explainers', 'Recruitment', 'Case studies'],
  'cinematographers-equipment-hire': ['Film sets', 'Event coverage', 'Commercials', 'Documentaries', 'Music videos'],
};
const DEFAULT_OVERVIEW: [string, string] = [
  'Tell us what you are trying to achieve and we shape the service around it — scope, schedule and quote agreed before any work begins.',
  'You get a dedicated point of contact, review rounds on every draft, and final files prepared for each platform you publish to.',
];
const overview = OVERVIEW[service.slug] ?? DEFAULT_OVERVIEW;
const bestFor = BEST_FOR[service.slug] ?? ['Events', 'Brands', 'Campaigns'];

const FAQS = [
  ['How much does it cost?', 'Every project is quoted on scope — crew days, kit and edit time. Tell us what you need and we reply with a clear, itemised quote.'],
  ['How fast can you deliver?', 'Time depends on scope, but event highlights typically land within one to two weeks. Tight deadline? Tell us upfront and we plan around it.'],
  ['Do you travel outside Kampala?', 'Yes — we are Kampala-based and regularly shoot across Uganda and the region. Travel is itemised in your quote.'],
  ['We already have footage. Can you just finish it?', 'Absolutely — that is exactly what our editing and post-production services are for. Send a sample and we take it from there.'],
];

const meta = service.summary.slice(0, 155);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  provider: { '@type': 'Organization', name: 'The Filmage' },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base
  title={`${service.title} | The Filmage`}
  description={meta}
  image={service.imagePublicId ? img(service.imagePublicId, 1200) : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <article class="mx-auto max-w-7xl px-5 pb-24 pt-36">
    <nav aria-label="Breadcrumb" class="text-sm text-ash">
      <a href="/services" class="hover:text-amber">Services</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-bone">{service.title}</span>
    </nav>
    <div data-hero>
      <h1 data-hero-item class="display mt-4 text-[clamp(3rem,9vw,8rem)]">{service.title}</h1>
      <p data-hero-item class="mt-8 max-w-2xl text-lg text-ash">{service.summary}</p>
      <ul data-hero-item aria-label="Best for" class="mt-6 flex flex-wrap gap-2">
        {bestFor.map((b) => (
          <li class="border border-amber/40 px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-amber">{b}</li>
        ))}
      </ul>
    </div>

    {
      service.imagePublicId && (
    <div data-reveal>
      <img
        src={img(service.imagePublicId, 1280)}
        srcset={srcset(service.imagePublicId)}
        sizes="100vw"
        alt={service.title}
        width="1280"
        height="720"
        loading="eager"
        decoding="async"
        class="mt-12 w-full bg-coal"
      />
    </div>
      )
    }

    <div data-reveal class="mt-12 flex flex-wrap gap-4">
      <a href="/contact" class="bg-amber px-8 py-4 font-extrabold text-ink">Book This Service</a>
      <a href="/work" class="border border-white/30 px-8 py-4 font-extrabold hover:border-amber hover:text-amber">View Our Work</a>
    </div>

    <section data-reveal class="mt-20 grid max-w-4xl gap-6 text-lg leading-relaxed text-bone" aria-label="About this service">
      <p>{overview[0]}</p>
      <p class="text-ash">{overview[1]}</p>
    </section>

    <section data-reveal class="mt-20 border border-white/10 bg-coal p-8 md:p-12" aria-labelledby="included">
      <h2 id="included" class="display text-4xl md:text-5xl">What's <span class="text-amber">included</span></h2>
      <ul class="mt-8 grid gap-x-10 gap-y-4 md:grid-cols-2">
        {includes.map((item) => (
          <li class="flex gap-3 text-bone"><span aria-hidden="true" class="font-extrabold text-amber">✓</span>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-20" aria-labelledby="process">
      <h2 data-reveal id="process" class="display text-4xl md:text-5xl">How we <span class="text-amber">work</span></h2>
      <ol class="mt-8 grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-4">
        {STEPS.map(([title, body], i) => (
          <li data-reveal class="bg-ink p-8">
            <span class="display text-5xl text-amber">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-extrabold">{title}</h3>
            <p class="mt-2 text-sm text-ash">{body}</p>
          </li>
        ))}
      </ol>
    </section>

    {work.length > 0 && (
      <section class="mt-20" aria-labelledby="service-work">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 data-reveal id="service-work" class="display text-4xl md:text-5xl">Recent <span class="text-amber">work</span></h2>
          <a data-reveal href="/work" class="text-sm font-extrabold text-amber">See all work →</a>
        </div>
        <ul class="mt-8 grid gap-8 md:grid-cols-3">
          {work.map(({ p, categoryName }) => <li data-reveal><ProjectCard p={{ ...p, categoryName }} /></li>)}
        </ul>
      </section>
    )}

    {kindWords.length > 0 && (
      <section class="mt-20 border-y border-white/10 py-14" aria-labelledby="service-words">
        <h2 data-reveal id="service-words" class="display text-4xl md:text-5xl">Clients <span class="text-amber">say</span></h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-2">
          {kindWords.map((t) => (
            <li data-reveal class="border border-white/10 bg-coal p-8">
              <p class="text-amber" aria-label={`${t.rating} out of 5`}>{'★'.repeat(t.rating)}</p>
              <blockquote class="mt-3 leading-relaxed">“{t.body}”</blockquote>
              <p class="mt-4 text-sm text-ash">{t.clientName}{t.clientCompany ? `, ${t.clientCompany}` : ''}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-20" aria-labelledby="faq">
      <h2 data-reveal id="faq" class="display text-4xl md:text-5xl">Common <span class="text-amber">questions</span></h2>
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {FAQS.map(([q, a]) => (
          <details data-reveal class="group py-5">
            <summary class="cursor-pointer list-none font-extrabold transition group-open:text-amber hover:text-amber">{q}</summary>
            <p class="mt-3 max-w-2xl text-ash">{a}</p>
          </details>
        ))}
      </div>
      <div data-reveal class="mt-10">
        <a href="/contact" class="bg-amber px-8 py-4 font-extrabold text-ink">Get a free quote</a>
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="mt-24" aria-labelledby="other-services">
          <h2 data-reveal id="other-services" class="display text-5xl">Other services</h2>
          <ul class="mt-8 grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-3">
            {others.map((s) => (
              <li data-reveal class="bg-ink p-8">
                <h3 class="display text-3xl">
                  <a href={`/services/${s.slug}`} class="transition hover:text-amber">
                    {s.title}
                  </a>
                </h3>
                <p class="mt-3 line-clamp-3 text-ash">{s.summary}</p>
                <a href={`/services/${s.slug}`} class="mt-4 inline-block text-sm font-extrabold text-amber">
                  Learn more →
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
