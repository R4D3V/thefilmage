---
import Base from '@/layouts/Base.astro';
import { and, asc, eq, ne } from 'drizzle-orm';
import { getDb, schema } from '@/db/client';
import { img, srcset } from '@/lib/cloudinary';

const db = getDb();
const slug = Astro.params.slug!;
const [service] = await db
  .select()
  .from(schema.services)
  .where(and(eq(schema.services.slug, slug), eq(schema.services.published, true)))
  .limit(1);
if (!service) return new Response(null, { status: 404 });

const others = await db
  .select()
  .from(schema.services)
  .where(and(eq(schema.services.published, true), ne(schema.services.id, service.id)))
  .orderBy(asc(schema.services.position))
  .limit(6);

const desc = service.summary.slice(0, 155);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  provider: { '@type': 'Organization', name: 'The Filmage' },
};
---
<Base
  title={`${service.title} | The Filmage`}
  description={desc}
  image={service.imagePublicId ? img(service.imagePublicId, 1200) : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="mx-auto max-w-7xl px-5 pb-24 pt-36">
    <nav aria-label="Breadcrumb" class="text-sm text-ash">
      <a href="/services" class="hover:text-amber">Services</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-bone">{service.title}</span>
    </nav>
    <h1 class="display mt-4 text-[clamp(3rem,9vw,8rem)]">{service.title}</h1>
    <p class="mt-8 max-w-2xl text-lg text-ash">{service.summary}</p>

    {
      service.imagePublicId && (
        <img
          src={img(service.imagePublicId, 1280)}
          srcset={srcset(service.imagePublicId)}
          sizes="100vw"
          alt={service.title}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          class="mt-12 w-full bg-coal"
        />
      )
    }

    <div class="mt-12 flex flex-wrap gap-4">
      <a href="/contact" class="bg-amber px-8 py-4 font-extrabold text-ink">Book This Service</a>
      <a href="/work" class="border border-white/30 px-8 py-4 font-extrabold hover:border-amber hover:text-amber">View Our Work</a>
    </div>

    {
      others.length > 0 && (
        <section class="mt-24" aria-labelledby="other-services">
          <h2 id="other-services" class="display text-5xl">Other services</h2>
          <ul class="mt-8 grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-3">
            {others.map((s) => (
              <li class="bg-ink p-8">
                <h3 class="display text-3xl">
                  <a href={`/services/${s.slug}`} class="transition hover:text-amber">
                    {s.title}
                  </a>
                </h3>
                <p class="mt-3 line-clamp-3 text-ash">{s.summary}</p>
                <a href={`/services/${s.slug}`} class="mt-4 inline-block text-sm font-extrabold text-amber">
                  Learn more →
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
