---
import Admin from '@/layouts/Admin.astro';
import { desc, eq } from 'drizzle-orm';
import { getDb, schema } from '@/db/client';
import { int } from '@/lib/admin';
const db = getDb();
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData(); const id = int(f, 'id'); const intent = String(f.get('intent'));
  if (intent === 'read' || intent === 'unread') await db.update(schema.contactMessages).set({ isRead: intent === 'read' }).where(eq(schema.contactMessages.id, id));
  else if (intent === 'delete') await db.delete(schema.contactMessages).where(eq(schema.contactMessages.id, id));
  return Astro.redirect('/admin/messages');
}
const rows = await db.select().from(schema.contactMessages).orderBy(desc(schema.contactMessages.createdAt)).limit(200);
const btn = 'border border-white/20 px-3 py-1 text-xs hover:border-amber';
---
<Admin title="Messages">
  {rows.length === 0 && <p class="text-ash">No messages yet.</p>}
  <ul class="max-w-3xl space-y-3">
    {rows.map((m) => (
      <li class:list={['border p-4', m.isRead ? 'border-white/10' : 'border-amber']}>
        <div class="flex flex-wrap justify-between gap-2 text-sm">
          <strong>{!m.isRead && <span class="text-amber">● </span>}{m.name}</strong>
          <time class="text-ash" datetime={m.createdAt.toISOString()}>{m.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</time>
        </div>
        <p class="mt-1 text-sm text-ash"><a class="text-bone underline" href={`mailto:${m.email}`}>{m.email}</a>{m.phone && <> · <a href={`tel:${m.phone}`}>{m.phone}</a></>}{m.company && ` · ${m.company}`}</p>
        <p class="mt-1 text-xs text-ash">{m.service || 'No service chosen'} · {m.budget || 'No budget given'}</p>
        <p class="mt-3 whitespace-pre-line">{m.message}</p>
        <form method="post" class="mt-4 flex gap-2"><input type="hidden" name="id" value={m.id} />
          <button name="intent" value={m.isRead ? 'unread' : 'read'} class={btn}>{m.isRead ? 'Mark unread' : 'Mark as read'}</button>
          <button name="intent" value="delete" class={`${btn} text-red-400`} onclick="return confirm('Delete this message?')">Delete</button></form>
      </li>
    ))}
  </ul>
</Admin>
