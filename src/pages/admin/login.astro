---
import '@/styles/global.css';
import { eq } from 'drizzle-orm';
import { z } from 'zod';
import { getDb, schema } from '@/db/client';
import { getEnv } from '@/lib/env';
import { verifyPassword } from '@/lib/password';
import { COOKIE, cookieOptions, createSession } from '@/lib/session';

let error = '';
const resetDone = Astro.url.searchParams.get('reset') === '1';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const p = z.object({ email: z.email().max(255), password: z.string().min(1).max(200) })
    .safeParse({ email: form.get('email'), password: form.get('password') });
  const [user] = p.success
    ? await getDb().select().from(schema.users).where(eq(schema.users.email, p.data.email.toLowerCase())).limit(1)
    : [];
  // Always run a verify to keep timing similar for unknown emails.
  const ok = user ? await verifyPassword(p.success ? p.data.password : '', user.passwordHash)
    : (await verifyPassword('x', 'pbkdf2$100000$AAAAAAAAAAAAAAAAAAAAAA==$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA='), false);
  if (user && ok) {
    Astro.cookies.set(COOKIE, await createSession(user.id, getEnv().AUTH_SECRET), cookieOptions);
    return Astro.redirect('/admin');
  }
  error = 'Invalid email or password.';
}
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" /><title>Admin sign in</title></head>
<body class="grid min-h-svh place-items-center bg-ink px-5">
  <form method="post" class="w-full max-w-sm space-y-4">
    <img src="/logo-sm.png" alt="The Filmage" width="160" height="73" class="mx-auto h-16 w-auto" />
    {error && <p role="alert" class="text-sm text-red-400">{error}</p>}
    {resetDone && <p role="status" class="text-sm text-green-400">Password updated. Sign in below.</p>}
    <label class="block text-sm">Email<input name="email" type="email" required autocomplete="username" class="mt-1 w-full bg-coal p-3" /></label>
    <label class="block text-sm">Password<input name="password" type="password" required autocomplete="current-password" class="mt-1 w-full bg-coal p-3" /></label>
    <button class="w-full bg-amber p-3 font-extrabold text-ink">Sign in</button>
    <p class="text-center text-sm"><a class="text-ash hover:text-bone" href="/admin/reset">Forgot password?</a></p>
  </form>
</body></html>
