---
import '@/styles/global.css';
import { eq } from 'drizzle-orm';
import { z } from 'zod';
import { getDb, schema } from '@/db/client';
import { getEnv } from '@/lib/env';
import { hashPassword } from '@/lib/password';

const env = getEnv();
const resetPin = env.ADMIN_RESET_PIN || '0781504804';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? form.get('username') ?? '').trim().toLowerCase();
  const pin = String(form.get('pin') ?? form.get('secretPin') ?? form.get('secret_pin') ?? '').trim();
  const password = String(form.get('password') ?? form.get('newPassword') ?? form.get('new_password') ?? '');
  const confirm = String(form.get('confirm') ?? form.get('confirmPassword') ?? form.get('confirm_password') ?? form.get('passwordConfirm') ?? '');

  if (!resetPin) {
    error = 'Password reset is not configured (missing ADMIN_RESET_PIN).';
  } else if (!z.email().safeParse(email).success) {
    error = 'Enter a valid email.';
  } else if (!pin) {
    error = 'Secret pin is required.';
  } else if (password.length < 12) {
    error = 'New password must be at least 12 characters.';
  } else if (password !== confirm) {
    error = 'Passwords do not match.';
  } else {
    // Constant-time comparison of the pin.
    let pinOk = pin.length === resetPin.length;
    let diff = 0;
    for (let i = 0; i < resetPin.length; i++) {
      diff |= (pin.charCodeAt(i) || 0) ^ resetPin.charCodeAt(i);
    }
    if (!pinOk || diff !== 0) {
      error = 'Invalid secret pin.';
    } else {
      const [user] = await getDb().select().from(schema.users).where(eq(schema.users.email, email)).limit(1);
      if (!user) {
        error = 'No account found for that email.';
      } else {
        await getDb().update(schema.users).set({ passwordHash: await hashPassword(password) }).where(eq(schema.users.id, user.id));
        return Astro.redirect('/admin/login?reset=1');
      }
    }
  }
}
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" /><title>Reset admin password</title></head>
<body class="grid min-h-svh place-items-center bg-ink px-5">
  <form method="post" class="w-full max-w-sm space-y-4">
    <img src="/logo-sm.png" alt="The Filmage" width="160" height="73" class="mx-auto h-16 w-auto" />
    <h1 class="text-center text-lg font-bold text-bone">Reset admin password</h1>
    {error && <p role="alert" class="text-sm text-red-400">{error}</p>}
    <label class="block text-sm">Email<input name="email" type="email" required autocomplete="username" value="jimstylz01@gmail.com" class="mt-1 w-full bg-coal p-3" /></label>
    <label class="block text-sm">Secret pin<input name="pin" type="password" required inputmode="numeric" class="mt-1 w-full bg-coal p-3" /></label>
    <label class="block text-sm">New password<input name="password" type="password" required minlength="12" autocomplete="new-password" class="mt-1 w-full bg-coal p-3" /></label>
    <label class="block text-sm">Confirm password<input name="confirm" type="password" required minlength="12" autocomplete="new-password" class="mt-1 w-full bg-coal p-3" /></label>
    <button class="w-full bg-amber p-3 font-extrabold text-ink">Reset password</button>
    <p class="text-center text-sm"><a class="text-ash hover:text-bone" href="/admin/login">Back to sign in</a></p>
  </form>
</body></html>