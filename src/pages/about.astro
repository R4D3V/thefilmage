---
import Base from '@/layouts/Base.astro';
import { getSettings } from '@/lib/settings';
const s = await getSettings();
const pair = (raw: string | undefined) => (raw ?? '').split('\n').map((l) => l.split('|').map((x) => x.trim())).filter(([a]) => a).map(([a, b]) => [a!, b ?? ''] as const);
const intro = s.about_intro || `${s.business_name} is a video production house. We cover events, social media, film, music videos, documentaries, adverts and podcasts, and we hire out cinematographers and equipment, stream live events and finish every project with professional editing and colour grading.`;
const mission = s.mission || 'To tell stories with purpose — creating video and imagery that moves people and helps our clients reach theirs.';
const philosophy = s.philosophy || '';
const team = pair(s.team).length ? pair(s.team) : [['Khaukha Jim', 'C.E.O']] as const;
const stats = pair(s.stats);
---
<Base title={`About | ${s.business_name}`} description={intro.slice(0, 155)}>
  <section class="mx-auto max-w-7xl px-5 pb-16 pt-36">
    <h1 data-hero class="display text-[clamp(3.5rem,11vw,9rem)]">About us</h1>
    <p data-reveal class="mt-8 max-w-3xl whitespace-pre-line text-xl text-ash">{intro}</p>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-5 pb-20 md:grid-cols-2">
    <div data-reveal><h2 class="display text-5xl text-amber">Mission</h2><p class="mt-4 whitespace-pre-line text-ash">{mission}</p></div>
    {philosophy && <div data-reveal><h2 class="display text-5xl text-amber">Creative philosophy</h2><p class="mt-4 whitespace-pre-line text-ash">{philosophy}</p></div>}
  </section>

  {stats.length > 0 && (
    <section class="border-y border-white/10 px-5 py-14" aria-label="Achievements">
      <dl class="mx-auto grid max-w-7xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map(([n, l]) => <div data-reveal><dd class="display text-6xl text-amber">{n}</dd><dt class="mt-1 text-sm text-ash">{l}</dt></div>)}
      </dl>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-5 py-20">
    <h2 data-reveal class="display text-6xl md:text-8xl">Team</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map(([name, role]) => <li data-reveal class="border border-white/10 p-6"><p class="text-xl font-extrabold">{name}</p><p class="text-sm text-amber">{role}</p></li>)}
    </ul>
  </section>

  <section class="bg-amber px-5 py-20 text-ink">
    <div data-reveal="scale" class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <h2 class="display text-5xl md:text-7xl">Have a story to tell?</h2>
      <a href="/contact" class="bg-ink px-8 py-4 font-extrabold text-bone">Let's Work Together</a>
    </div>
  </section>
</Base>
