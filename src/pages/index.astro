---
import Base from '@/layouts/Base.astro';
import { asc, eq, and, desc } from 'drizzle-orm';
import { getDb, schema } from '@/db/client';
import { getSettings } from '@/lib/settings';
import { img, srcset, videoPoster, videoSrc } from '@/lib/cloudinary';

const db = getDb();
const s = await getSettings();
const [services, projects, testimonials] = await Promise.all([
  db.select().from(schema.services).where(eq(schema.services.published, true)).orderBy(asc(schema.services.position)),
  db.select().from(schema.projects).where(and(eq(schema.projects.published, true), eq(schema.projects.featured, true)))
    .orderBy(asc(schema.projects.position)).limit(6),
  db.select().from(schema.testimonials).where(eq(schema.testimonials.published, true)).orderBy(desc(schema.testimonials.createdAt)).limit(3),
]);
const heroVideo = s.hero_video_public_id;
---
<Base>
  <section class="relative isolate flex h-svh min-h-[560px] items-end overflow-hidden px-5 pb-16 pt-32">
    {heroVideo && (
      <video data-parallax class="absolute inset-0 -z-10 h-full w-full object-cover opacity-50" autoplay muted loop playsinline preload="auto" poster={videoPoster(heroVideo)}>
        <source src={videoSrc(heroVideo, 1280).webm} type="video/webm" />
        <source src={videoSrc(heroVideo, 1280).mp4} type="video/mp4" />
      </video>
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-transparent"></div>
    <div data-hero class="mx-auto w-full max-w-7xl">
      <h1 data-hero-item class="display text-[clamp(1.75rem,6.5vw,5.5rem)] lg:text-[4rem]">{s.hero_heading}</h1>
      <p data-hero-item class="mt-6 max-w-xl text-lg text-ash">{s.hero_description}</p>
      <div data-hero-item class="mt-8 flex flex-wrap gap-4">
        <a href="/work" class="bg-amber px-7 py-4 font-extrabold text-ink">View Our Work</a>
        <a href="/contact" class="border border-white/30 px-7 py-4 font-extrabold hover:border-amber hover:text-amber">Let's Work Together</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-24" id="services">
    <h2 data-reveal class="display text-6xl md:text-8xl">What we do</h2>
    <ul class="mt-12 grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-3">
      {services.map((sv, i) => (
        <li data-reveal class="bg-ink p-8">
          <span class="text-sm font-extrabold text-amber">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="display mt-3 text-4xl"><a href={`/services/${sv.slug}`} class="transition hover:text-amber">{sv.title}</a></h3>
          <p class="mt-3 text-ash">{sv.summary}</p>
          <a href={`/services/${sv.slug}`} class="mt-4 inline-block text-sm font-extrabold text-amber">Learn more →</a>
        </li>
      ))}
    </ul>
  </section>

  {projects.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pb-24">
      <h2 data-reveal class="display text-6xl md:text-8xl">Selected work</h2>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <li data-reveal>
            <a href={`/work/${p.slug}`} class="group block">
              {p.coverPublicId && (
                <img src={img(p.coverPublicId, 768, { h: 576 })} srcset={srcset(p.coverPublicId)} sizes="(min-width:1024px) 33vw,(min-width:768px) 50vw,100vw"
                  alt={p.title} width="768" height="576" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]" />
              )}
              <h3 class="mt-4 text-xl font-extrabold group-hover:text-amber">{p.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pb-24">
      <h2 data-reveal class="display text-6xl md:text-8xl">Kind words</h2>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <li data-reveal class="border border-white/10 p-8">
            <p class="text-amber" aria-label={`${t.rating} out of 5`}>{'★'.repeat(t.rating)}</p>
            <blockquote class="mt-3">{t.body}</blockquote>
            <p class="mt-4 text-sm text-ash">{t.clientName}{t.clientCompany ? `, ${t.clientCompany}` : ''}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="bg-amber px-5 py-20 text-ink">
    <div data-reveal="scale" class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <h2 class="display text-5xl md:text-7xl">Have a story to tell?</h2>
      <a href="/contact" class="bg-ink px-8 py-4 font-extrabold text-bone">Let's Work Together</a>
    </div>
  </section>
</Base>
