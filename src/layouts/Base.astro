---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Motion from '@/components/Motion.astro';
import { getSettings } from '@/lib/settings';
import { img } from '@/lib/cloudinary';

interface Props { title?: string; description?: string; image?: string | undefined; path?: string; }
const s = await getSettings();
const { title = s.seo_title, description = s.seo_description, image = s.logo_public_id ? img(s.logo_public_id, 1200, { h: 630 }) : undefined, path = Astro.url.pathname } = Astro.props;
const logo = s.logo_public_id ? img(s.logo_public_id, 320) : '/logo-sm.png';
const favicon = s.favicon_public_id ? img(s.favicon_public_id, 64, { h: 64 }) : '/logo-sm.png';
const canonical = new URL(path, Astro.site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService',
  name: s.business_name, url: Astro.site?.href, email: s.email, telephone: s.phone,
  slogan: s.tagline, address: s.address || undefined,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;600;800&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("motion")</script>
  </head>
  <body class="min-h-screen bg-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-amber focus:px-4 focus:py-2 focus:text-ink">Skip to content</a>
    <Header logo={logo} />
    <main id="main"><slot /></main>
    <Footer settings={s} logo={logo} />
    <Motion />
  </body>
</html>
