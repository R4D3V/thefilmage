# Neon pooled connection string (add ?sslmode=require)
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# Optional: used only by `npm run admin:create`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: secret pin for /admin/reset password reset
ADMIN_RESET_PIN=
